{
  "name": "civil-at-hand",
  "version": "4.1.0",
  "private": true,
  "description": "A private civil construction business workspace: CRM, projects and site diary, estimates and quotations, procurement and stock, workforce, finance, documents, tenders, public pages and secure bilingual forms.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "node --experimental-test-module-mocks --import tsx --test tests/integration/*.test.ts",
    "check": "npm run typecheck && npm test && npm run test:integration"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "mongoose": "^8.19.1",
    "next": "^16.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.35.0",
    "eslint-config-next": "^16.4.0",
    "typescript": "^5.9.3",
    "tsx": "^4.20.0"
  }
}
