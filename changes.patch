+.success{padding:58px 35px}.successIcon{margin:0 auto 22px;width:56px;height:56px;border-radius:50%;display:grid;place-items:center;background:#e7f7ef;color:#168359;font-size:28px}.success>p:not(.eyebrow){font-size:14px;line-height:1.7;max-width:520px;margin:12px auto}.failure p{line-height:1.6;overflow-wrap:anywhere}
